    <div class="card-grid" data-reveal="stagger">
      {%- for note in collections.notes | reverse %}
      <article class="card">
        <div class="card__body">
          <p class="card__label">{{ note.data.label | default("Engineering note") }}</p>
          <h3 class="card__title">{{ note.data.title }}</h3>
          <p class="card__desc">{{ note.data.description }}</p>
          <p class="card__date">
            <time datetime="{{ note.data.published }}">{{ note.data.published | dateEn }}</time>{% if note.data.readingTime %} · {{ note.data.readingTime }}{% endif %}
          </p>
          <a href="{{ note.url }}" class="card__link">Read the note →</a>
        </div>
      </article>
      {%- endfor %}
    </div>
