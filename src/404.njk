description: "Cette page n'existe pas ou a été déplacée."
noindex: true
twitterCard: summary
permalink: /404.html
---

{% block body %}
  {% include "partials/site-header.njk" %}

  <main>
    {%- set koraSeuil = "Il n'y a rien à cet endroit. Ce n'est pas moi qui l'ai déplacé : je ne déplace rien ici." %}
    {%- set seuilCompact = true %}
    <div class="container">{% include "partials/kora-seuil.njk" %}</div>
    <section class="hero hero--404">
      <div class="container">
        <p class="hero__label">Erreur 404</p>
        <h1 class="hero__title">
          Page introuvable
        </h1>
        <p class="hero__subtitle">
          Cette page n'existe pas, a été déplacée ou l'adresse est incorrecte.
        </p>
        <a href="/index.html" class="btn btn--primary">
          Retour à l'accueil
        </a>
      </div>
    </section>
  </main>

  {% include "partials/site-footer.njk" %}
{% endblock %}
