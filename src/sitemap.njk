---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- 28/10 : construit depuis les pages elles-mêmes, plus tenu à la main. Une page y entre si
    son `canonical` est sa propre URL (la redirection physique-quantique-conversationnelle
    pointe ailleurs, la 404 n'en a pas). `lastmod` seulement là où une date de modification
    est tenue (articles, notes) : une date inventée est pire qu'aucune. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all | sort(false, false, "url") %}
{%- if p.data.canonical and p.data.canonical == p.url and not p.data.noindex %}
  <url>
    <loc>{{ site.url }}{{ p.data.canonical }}</loc>
    {%- set modifie = p.data.dateModified or p.data.datePublished or p.data.published %}
    {%- if p.url == "/" %}
    {%- set modifie = (collections.articles | last).data.datePublished %}
    {%- endif %}
    {%- if modifie %}
    <lastmod>{{ modifie }}</lastmod>
    {%- endif %}
    <priority>{{ p.data.sitemapPriority | default("1.0" if p.url == "/" else ("0.8" if p.data.slug else "0.6")) }}</priority>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
