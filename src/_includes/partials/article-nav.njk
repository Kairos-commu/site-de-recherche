{#- Précédent / suivant (03/10) : à gauche le texte plus récent, à droite le plus ancien.
    La collection est triée du plus ancien au plus récent. -#}
{%- set articleList = collections.articles %}
{%- set currentIndex = -1 %}
{%- for article in articleList %}
  {%- if article.data.slug == slug %}
    {%- set currentIndex = loop.index0 %}
  {%- endif %}
{%- endfor %}

{%- if currentIndex < articleList.length - 1 %}
  {%- set plusRecent = articleList[currentIndex + 1] %}
{%- endif %}
{%- if currentIndex > 0 %}
  {%- set plusAncien = articleList[currentIndex - 1] %}
{%- endif %}

<nav class="article-nav" aria-label="Navigation articles">
  {%- if plusRecent %}
  <a href="/{{ plusRecent.data.slug }}.html" class="article-nav__link article-nav__link--prev">
    <span class="article-nav__label">← Plus récent</span>
    <span class="article-nav__title">{{ plusRecent.data.card.title }}</span>
  </a>
  {%- else %}
  <div class="article-nav__empty"></div>
  {%- endif %}
  {%- if plusAncien %}
  <a href="/{{ plusAncien.data.slug }}.html" class="article-nav__link article-nav__link--next">
    <span class="article-nav__label">Plus ancien →</span>
    <span class="article-nav__title">{{ plusAncien.data.card.title }}</span>
  </a>
  {%- else %}
  <div class="article-nav__empty"></div>
  {%- endif %}
</nav>
