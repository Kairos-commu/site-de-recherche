---
layout: layouts/base.njk
extraCss: article.css
ogType: article
bodyClass: article
siteNavPrefix: "/index.html"
---
{#- Le header est celui de tout le site : un article n'est plus une sortie de chez Kora -#}
{% include "partials/site-header.njk" %}

<!-- Progress bar -->
<div class="progress-bar">
  <div class="progress-bar-fill" id="progress"></div>
</div>

<!-- Sommaire sur petit écran (le burger du header ouvre la nav du site, pas celui-ci) -->
<button class="toc-toggle" id="tocToggle" aria-label="Sommaire de l'article" aria-controls="nav">
  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h10M4 12h16M4 18h12"/>
  </svg>
</button>

<!-- Navigation -->
<nav id="nav">
  <div class="nav-header">
    <span class="nav-header__label">{{ navLabel }}</span>
    <p>{{ navDescription }}</p>
  </div>

  <ul class="nav-list">
    {%- for section in sections %}
    <li><a href="#{{ section.id }}"{% if loop.first %} class="active"{% endif %}><span class="nav-number">{{ loop.index | pad }}</span>{{ section.title }}</a></li>
    {%- endfor %}
  </ul>

  <div class="nav-footer">
    <p>Florent Klimacek</p>
    <p>{{ site.year }}</p>
  </div>
</nav>

<!-- Main content -->
<main>
  <div class="content">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <a href="/index.html">Accueil</a>
      <span class="separator">›</span>
      <a href="/articles.html">Articles</a>
      <span class="separator">›</span>
      <span class="current">{{ breadcrumbName | default(headline) }}</span>
    </nav>

    {#- Le seuil : Kora présente le texte avant qu'on y entre. Auteur et dates
        viennent du front matter — elle ne dit ici que ce que la page sait d'elle-même. -#}
    {%- set seuilAuto -%}
      Ce texte est de Florent. Il l'a publié le {{ datePublished | dateFr }}{% if dateModified and dateModified != datePublished %} et l'a repris le {{ dateModified | dateFr }}{% endif %}. Je ne l'ai pas écrit — je le tiens ici.
    {%- endset %}
    {% include "partials/kora-seuil.njk" %}

    <!-- Hero -->
    <header class="hero">
      <p class="hero-label">{{ heroLabel }}</p>
      <h1>{{ heroH1 | safe }}</h1>
      <p class="hero-intro">
        {{ heroIntro | safe }}
      </p>
      <p class="hero-date"><time datetime="{{ datePublished }}">{{ datePublished | dateFr }}</time></p>
      {% if doi %}
      <p class="hero-doi">
        <a href="{{ doi }}" target="_blank" rel="noopener">
          <img src="https://zenodo.org/badge/DOI/{{ doi | replace('https://doi.org/', '') }}.svg" alt="DOI {{ doi | replace('https://doi.org/', '') }}">
        </a>
      </p>
      {% endif %}
      {% if heroImage %}
      <div class="hero-image-wrapper">
        <img src="{{ heroImage }}" alt="{{ heroImageAlt | default(headline) }}" class="hero-image" loading="eager">
      </div>
      {% endif %}
      <div class="hero-line"></div>
    </header>

    <!-- Article content -->
    {{ content | safe }}

    <!-- Article Navigation (prev/next) -->
    {% include "partials/article-nav.njk" %}

  </div>
</main>

{% include "partials/site-footer.njk" %}
