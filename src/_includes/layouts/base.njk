<!DOCTYPE html>
<html lang="{{ lang | default("fr") }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="{{ site.googleVerification }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {#- CSP pour tout le site (11/09 — elle ne vivait que sur la page KAIROS). Construite sur
      l'inventaire RÉEL de ce que les pages chargent : le badge DOI de Zenodo, le grain en data: URI
      de base.css, la vidéo de présentation servie par une release GitHub (github.com redirige vers
      objects.githubusercontent.com — trouvé par le test, pas supposé). 26/09 : GTM/GA retirés et
      polices auto-hébergées (css/fonts.css) — plus aucune requête vers Google, plus aucun cookie.
      'unsafe-inline' reste pour les scripts inline des pages (JSON-LD, présentation KAIROS). -#}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://zenodo.org; media-src 'self' https://github.com https://*.githubusercontent.com; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description }}">

  {% include "partials/head-meta.njk" %}

  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/base.css">
  {%- if extraCss %}
  <link rel="stylesheet" href="/css/{{ extraCss }}">
  {%- endif %}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate" type="application/rss+xml" title="Florent Klimacek — Articles" href="/feed.xml">
  {%- if canonical %}
  <link rel="canonical" href="{{ site.url }}{{ canonical }}">
  {%- endif %}
  {%- if extraHead %}
  {{ extraHead | safe }}
  {%- endif %}

  {%- if slug %}
  <!-- Schema.org BlogPosting -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "{{ headline }}",
    "description": "{{ description }}",
    "datePublished": "{{ datePublished }}",
    "dateModified": "{{ dateModified | default(datePublished) }}",
    "inLanguage": "fr",
    "url": "{{ site.url }}/{{ slug }}.html",
    "author": {
      "@type": "Person",
      "name": "{{ site.author.name }}",
      "url": "{{ site.url }}/about.html"
    },
    "publisher": {
      "@type": "Person",
      "name": "{{ site.author.name }}",
      "url": "{{ site.url }}/"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ site.url }}/{{ slug }}.html"
    },
    "image": "{{ (site.url + heroImage) if heroImage else site.ogImage }}",
    "keywords": {{ keywords | dump | safe }}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ site.url }}/" },
      { "@type": "ListItem", "position": 2, "name": "Articles", "item": "{{ site.url }}/articles.html" },
      { "@type": "ListItem", "position": 3, "name": "{{ breadcrumbName | default(headline) }}", "item": "{{ site.url }}/{{ slug }}.html" }
    ]
  }
  </script>
  {%- endif %}
  {%- if jsonLdRaw %}
  {{ jsonLdRaw | safe }}
  {%- endif %}
  {%- if activeNav == "download" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "KAIROS",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Linux, Windows 10+",
    "softwareVersion": "{{ kairos.version }}",
    "description": "Application Electron de cartographie cognitive assistée par IA. Système Oxygène, injection de friction, modes Assisté et Autonome.",
    "url": "{{ site.url }}/download.html"{% if kairos.downloadsAvailable %},
    "downloadUrl": "{{ kairos.platforms.linux.url }}",
    "fileSize": "{{ kairos.platforms.linux.sizeMo }} MB"{% endif %},
    "author": {
      "@type": "Person",
      "name": "{{ site.author.name }}",
      "url": "{{ site.url }}/about.html"
    },
    "image": "{{ site.ogImage }}",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    }
  }
  </script>
  {%- endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <!-- Le décor de Kora, sur chaque page (js/repere.js) -->
  <canvas class="kora-cosmos" aria-hidden="true"></canvas>
  <div class="kora-veil" aria-hidden="true"></div>
  {{ content | safe }}

  <script src="/js/site.js"></script>
  <script src="/js/repere.js" defer></script>
  {%- if extraJs %}
  <script src="/js/{{ extraJs }}" defer></script>
  {%- endif %}
</body>
</html>
