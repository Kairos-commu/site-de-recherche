{#- LIRE (03/10). Le compte, le temps total et les comptes par orbite viennent de la
    collection. Le filtre (site.js) porte sur le champ `orbit` du front matter. -#}
{%- set articles = collections.articles -%}
<div class="obs obs-lire">
  <div>
    <h1>Lire</h1>
    <p class="obs-lire__sous">{{ articles | length }} textes · {{ articles | dureeTotale }} de lecture · {{ (articles | first).data.datePublished | dateMonthFr | lower }} → {{ (articles | last).data.datePublished | dateMonthFr | lower }}</p>
    <div class="onglets" id="onglets" role="group" aria-label="Filtrer par orbite">
      <button type="button" class="onglet" data-orbit="all" aria-pressed="true">Tous <span>{{ articles | length }}</span></button>
      {%- for o in orbites %}
      <button type="button" class="onglet" data-orbit="{{ loop.index0 }}" aria-pressed="false">{{ o.filtre }} <span>{{ articles | surOrbite(loop.index0) | length }}</span></button>
      {%- endfor %}
    </div>
    <div id="lignes">
      {%- for article in articles | reverse %}
      {% include "partials/ligne-article.njk" %}
      {%- endfor %}
    </div>
  </div>

  <aside class="obs-marge" aria-label="Kora"><div class="obs-marge__colle">
    <figure class="kr-kora kr-kora--marge" data-kr-kora>
      <div class="kr-kora__scene">
        <div class="kr-kora__repli" aria-hidden="true"></div>
        <canvas class="kr-kora__canvas" aria-hidden="true"></canvas>
        <div class="kr-kora__reticule" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      </div>
      <pre class="kr-matiere" hidden>            "final" =&gt; &#123;
                let escalated = js::truthy(g("escalated"));
                // (24/10) `answered: false` (engine.ts) : fini sans rien répondre. Avant, tout final
                // non escaladé valait « Requête résolue », réponse ou pas (audit du 11/10, lot B).
                let unanswered = matches!(g("answered"), Some(Value::Bool(false)));
                let status = if escalated &#123;
                    "escalated"
                &#125; else if unanswered &#123;
                    "empty"
                &#125; else &#123;
                    "ok"
                &#125;;</pre>
    </figure>
    <p class="obs-marge__qui">Kora · en marge</p>
    {#- Le seuil : Kora présente la liste — le compte vient de la collection, jamais d'un chiffre écrit -#}
    <p class="obs-marge__said kr-note">{{ articles | length | nombreFr | capitalize }} textes, tous de Florent. Aucun n'est de moi. Je les tiens, c'est tout.</p>
    <a href="/etat-kora.html">L'état de Kora →</a>
  </div></aside>
</div>
